str(output.all.rootweight$coefficients)
unique(output.all.rootweight$coefficients)
output.all.rootweight$coefficients<-factor(output.all.rootweight$coefficients,
levels = c("TreatmentH:Day_Scale_7",
"TreatmentL:Day_Scale_7",
"TreatmentW:Day_Scale_7",
"Day_Scale_7:Night_Scale_7",
"(Intercept)", "TreatmentW",
"TreatmentL","TreatmentH",
"Day_Scale_7", "Night_Scale_7"),
labels = c("High SA Treatment \n Day Temperature",
"Low SA Treatment \n Day Temperature",
"Water Treatment \n Day Temperature",
"Day Temperature \n Night Temperature",
"(Intercept)", "Water Treatment",
"Low SA Treatment", "High SA Treatment",
"Day Temperature", "Night Temperature"))
output.all.rootweight$sigvar <-
ifelse(output.all.rootweight$Pr...t.. < 0.05, 1, 0)
rootweight_sig<-output.all.rootweight[which(output.all.rootweight$sigvar==1),]
RootWeight_Rasters <- ggplot(output.all.rootweight[-which(output.all.rootweight$coefficients=="(Intercept)"),],
aes(x=Species,y=coefficients))+
geom_raster(aes(fill=Estimate))+
geom_tile(data =rootweight_sig[-which(shootweight_sig$coefficients=="(Intercept)"),],
aes(x=Species,y=coefficients, fill = sigvar),fill="transparent",
col="black",size=2)+
scale_fill_gradient2(low = "red", high = "blue", mid = "white",
midpoint = 0, space = "Lab",
name="Effect")+
geom_text(aes(label = paste0(round(Estimate,7))))+
ylab("")+
xlab("")+
ggtitle("Temperature & Treatments Interactions with Root Biomass")+
theme_grey()+
theme(legend.position="bottom")
RootWeight_Rasters <- ggplot(output.all.rootweight[-which(output.all.rootweight$coefficients=="(Intercept)"),],
